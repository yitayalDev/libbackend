# Server Configuration
PORT=5000
NODE_ENV=production

# Allowed Frontend URL(s) for CORS (comma-separated if multiple)
FRONTEND_URL=https://your-frontend-domain.com

# Database - MongoDB Atlas connection string (keep secret!)
# Example: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/clm_system

# JWT Configuration (MUST be a random 64+ char secret in production)
# Run `node scripts/generateSecret.js` to create one
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
JWT_EXPIRE=24h

# Auto-seed initial demo data (Set to true only during first launch if needed, then false)
SEED_DATABASE=false

# Email Configuration (for password reset via Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-service-account@gmail.com
SMTP_PASS=your-google-app-password

# Admin Default Credentials (used only during initial seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_default_admin_password_immediately

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Telegram Bot Configuration (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# SuperAdmin Password Reset Phone Number
SUPERADMIN_PHONE=+251900000000
